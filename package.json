{
    "name": "mailgun-to-ses-proxy",
    "version": "2.1.1",
    "private": true,
    "scripts": {
        "dev": "nodemon",
        "next:build": "next build --webpack",
        "docker:build": "docker build --file dockerfile --tag mailgun-to-ses-proxy .",
        "build": "prisma generate && next build --webpack && tsc --project tsconfig.server.json && sh scripts/build-newsletter-retention-linkat.sh && sh scripts/assert-server-artifacts.sh",
        "start": "NODE_ENV=production prisma migrate deploy && node dist/server.js",
        "start:bun": "NODE_ENV=production prisma migrate deploy && bun dist/server.js",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.server.json",
        "db:migrate:dev": "prisma migrate dev",
        "db:migrate": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "reconcile:newsletter-orphan": "NODE_ENV=production bun dist/scripts/reconcile-newsletter-orphan.js",
        "retention:newsletter": "NODE_ENV=production bun dist/scripts/newsletter-retention.js",
        "test": "runPrismaTests=false vitest",
        "test:prisma": "vitest --run tests/prisma-orm.test.ts",
        "test:run": "runPrismaTests=false vitest --run",
        "test:ci:db": "sh -c 'mkdir -p artifacts; runPrismaTests=true vitest run --reporter=json --outputFile=artifacts/vitest-report.json; status=$?; node scripts/assert-vitest-report.mjs artifacts/vitest-report.json; report_status=$?; exit $((status || report_status))'",
        "test:analytics-index-migration": "node scripts/test-analytics-index-migration.mjs",
        "test:retention-link-helper": "node --no-warnings scripts/test-newsletter-retention-link-helper.mjs",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "bump": "npm version patch && git push --tags"
    },
    "dependencies": {
        "@aws-sdk/client-sesv2": "^3.1054.0",
        "@aws-sdk/client-sqs": "^3.1054.0",
        "@prisma/adapter-mariadb": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "lucide-react": "^1.16.0",
        "mariadb": "^3.5.3",
        "next": "^16.3.3",
        "pino": "^10.3.1",
        "prisma": "^7.10.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@types/node": "^24.12.4",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.2.11",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "tailwindcss": "^4.3.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    },
    "overrides": {
        "@hono/node-server": "2.0.11",
        "mariadb": "$mariadb",
        "deepmerge-ts": "8.0.2",
        "fast-uri": "3.1.6",
        "sharp": "0.35.3"
    }
}
